                }
                // Sizes C
                {
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 4
                }
                // Sizes D
                {
                    seqLen: 48
                    dModel: 512
                    dtRank: 24
                    nb_tiles: 32
                }
            ]
        }
        {
            app: P2-tiled-D
            params: [
                // Sizes B
