{
    // Max number of vsim runs allowed to execute at the same time
    max_parallel: 8
    // Per-run wall-clock cap in seconds. 0 = no timeout
    timeout: 0 // suc-async 32k can take >12h
    // Per-build  wall-clock cap in seconds. 0 = no timeout
    build_timeout: 0
    // Global default for `force`
    force: false

    runs: [
        {
            app: main-tiled
            params: [
                // {
                //     seqLen: 784
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 4
                // }
                // Sizes C
                {
                    name: IN main C
                    force: false
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16 // power of 2. 8 too small
                    bc_pad_banks: 4
                    safe_to_start_r10: 11
                    safe_to_start_r11: 6000 // 8350
                }
                // {
                //     name: IN main C
                //     seqLen: 192
                //     dModel: 384
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 0
                //     safe_to_start_r10: 9
                //     safe_to_start_r11: 1990
                // }
                // Sizes D
                {
                    name: IN main D
                    force: false
                    seqLen: 48
                    dModel: 528
                    dtRank: 24
                    nb_tiles: 11
                    bc_pad_banks: 4
                    safe_to_start_r10: 5
                    safe_to_start_r11: 3000
                }
            ]
        }
        {
            app: main-tiled-oscore
            params: [
                {
                    name: IN main C
                    force: false
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    nb_l_tiles: 12
                    nb_slots: 2
                    bc_pad_banks: 0
                    safe_to_start_r10: 8
                    safe_to_start_r11: 6000
                }

            ]
        }
        {
            app: P1-tiled-D
            params: [
                {
                    name: IN P1 A
                    force: false
                    seqLen: 784 // x4
                    dModel: 96
                    dtRank: 24
                    nb_tiles: 4
                }
                {
                    name: IN P1 B
                    force: false
                    seqLen: 784
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                }
                // // Sizes C (ImageNet) -> use main instead
                // // Sizes D (ImageNet) -> use main instead
                {
                    name: CS P1 C
                    force: false
                    seqLen: 512 // x4 -> 2048
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16 // dModel/24
                }
                {
                    name: CS P1 D
                    force: false
                    seqLen: 256 // x2 -> 512
                    dModel: 504 // 512 not divisible by 24
                    dtRank: 24
                    nb_tiles: 21 // dModel/24
                }
            ]
        }
        {
            app: P2-tiled-D
            params: [
                {
                    name: IN P2 C
                    force: false
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    bc_pad_banks: 4
                    safe_to_start_r10: 10
                    safe_to_start_r11: 7500
                }
                {
                    name: IN P2 D
                    force: false
                    seqLen: 48
                    dModel: 480
                    dtRank: 24
                    nb_tiles: 10
                    bc_pad_banks: 4
                    safe_to_start_r10: 4
                    safe_to_start_r11: 3500
                }
            ]
        }
        {
            app: double-gemm-conflict-free
            params: [
                { // z proj
                    name: CS P2 in proj B
                    force: false
                    seqLen: 512 // 8x (kernel does 2x this L -> 8k total)
                    dModel: 192
                    dInner: 384
                    dtRank: 24
                    nb_tiles: 16
                }
                { // out proj
                    name: CS P2 out proj B
                    force: false
                    seqLen: 256 // 16x (kernel does 2x this L -> 8k total)
                    dModel: 384
                    dInner: 192
                    dtRank: 24
                    nb_tiles: 8
                }
                // Sizes C
                { // in proj
                    name: CS P2 in proj C
                    force: false
                    seqLen: 128 // x8
                    dModel: 384
                    dInner: 768
                    dtRank: 24
                    nb_tiles: 16 // dInner / 48 per tile
                }
                { // out proj
                    name: CS P2 out proj C
                    force: false
                    seqLen: 64 // x16
                    dModel: 768
                    dInner: 384
                    dtRank: 24
                    nb_tiles: 8
                }
                // Sizes D
                { // out proj
                    name: CS P2 out proj D
                    force: false
                    seqLen: 64 // x4
                    dModel: 1024
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 11
                }
                // CS SSM block1 (D96) reuses the IN in/out proj A params below.
                // ImageNet
                // Sizes A
                { // z proj
                    name: IN P2 in proj A
                    force: false
                    seqLen: 784 // 2x (kernel does 2x this L -> 3k total)
                    dModel: 96
                    dInner: 192
                    dtRank: 24
                    nb_tiles: 4
                }
                { // out proj
                    name: IN P2 out proj A
                    force: false
                    seqLen: 400 // 4x (kernel does 2x this L -> 3k total)
                    dModel: 192
                    dInner: 96
                    dtRank: 24
                    nb_tiles: 4 // 8 not possible
                }
                { // out proj
                    name: IN P2 out proj B
                    force: false
                    seqLen: 192 // 4x (kernel does 2x this L -> 784)
                    dModel: 384
                    dInner: 192
                    dtRank: 24
                    nb_tiles: 8
                }

                {  // FFT
                    name: IN fft D
                    force: false
                    seqLen: 48
                    dModel: 512
                    dInner: 1056
                    nb_tiles: 11
                }
            ]
        }
        {
            // SUC P2, all but out proj
            app: P2-async-OS-no-IS
            params: [
                {
                    name: IN SUC/in proj B
                    force: false
                    seqLen: 768
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 4
                    nb_slots: 2
                    safe_to_start_r10: 40
                    safe_to_start_r11: 0 // not used
                }
                {
                    name: CS SUC/in proj D
                    force: false
                    seqLen: 1024
                    dModel: 528
                    dtRank: 24
                    nb_tiles: 11
                    nb_l_tiles: 16
                    nb_slots: 2
                    safe_to_start_r10: 27
                    safe_to_start_r11: 0 // not used
                }
            ]
        }
        {
            // SUC-only with dt tiling. Only the largest seqLen needs to tile dt.
            app: suc-async-dt
            params: [
                {
                    name: CS SUC A
                    force: false
                    seqLen: 32768 // x2
                    dModel: 96
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 128 // L_tile=512
                    nb_slots: 2
                    bc_pad_banks: 4
                    nb_dt_tiles : 32
                    nb_dt_slots : 2
                    safe_to_start_r10: 0 // not used
                    safe_to_start_r11: 0 // not used
                }
                {
                    name: CS SUC B
                    force: false
                    seqLen: 16384
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 16 // L_tile=512
                    nb_slots: 2
                    bc_pad_banks: 4
                    nb_dt_tiles : 16
                    nb_dt_slots : 2
                    safe_to_start_r10: 0 // not used
                    safe_to_start_r11: 0 // not used
                }
            ]
        }
        {
            // SUC-only, no dt tiling, no z-proj or out-proj
            app: suc-async
            params: [
                // Sizes C
                {
                    name: CS SUC C
                    force: false
                    seqLen: 4096
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    nb_l_tiles: 4 // L_tile=512
                    nb_slots: 2
                    bc_pad_banks: 4
                }

                // ImageNet
                // Sizes A
                {
                    name: IN SUC A
                    force: false
                    seqLen: 3136
                    dModel: 96
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 4
                    nb_slots: 2
                    bc_pad_banks: 4
                }

            ]
        }
        {
            app: einfft-tiled
            params: [

                {
                    name: IN einfft A
                    force: false
                    seqLen: 784 // x4
                    dModel: 96 // N=1 -> concat [W_re|W_im] gives real N=2 (no waste)
                    nb_tiles: 1
                }


                // Sizes A -> plain einfft-tiled
                {
                    name: CS einfft A
                    force: false
                    seqLen: 512 // x64 -> 32768
                    dModel: 96
                    nb_tiles: 1
                }
            ]
        }
        {
            app: einfft-double-conflictfree
            params: [

                {
                    name: IN einfft B
                    force: false
                    seqLen: 192 // x4
                    dModel: 192
                }
                // Sizes C
                {
                    name: IN einfft C
                    force: false
                    seqLen: 96 // x2
                    dModel: 384
                }
                // Sizes D
                {
                    name: IN einfft D
                    force: false
                    seqLen: 48
                    dModel: 576
                }
                // NOTE we reuse IN runs
                // Sizes A -> plain einfft-tiled
                // {
                //     name: CS einfft B
                //     force: false
                //     seqLen: 256 // x32 -> 8192
                //     dModel: 192
                // }
                // // Sizes C
                // {
                //     name: CS einfft C
                //     force: false
                //     seqLen: 128 // x16 -> 2048
                //     dModel: 384
                // }
                // // Sizes D
                // {
                //     name: CS einfft D
                //     force: false
                //     seqLen: 512
                //     dModel: 512
                // }
            ]
        }
        {
            app: fft-tiled
            params: [
                {
                    name: IN fft B
                    force: false
                    seqLen: 1024,
                    dModel: 96, // x2
                    L1: 32,
                    L2: 32,
                    nb_tiles: 4,
                    nb_tiles_B: 2
                }
                {
                    name: IN fft C
                    force: false
                    seqLen: 256,
                    dModel: 384,
                    L1: 16,
                    L2: 16,
                    nb_tiles: 4,
                    nb_tiles_B: 2
                }
                {
                    name: CS fft C
                    force: false
                    seqLen: 4096,
                    dModel: 16, // 24
                    L1: 64,
                    L2: 64,
                    nb_tiles: 8,
                    nb_tiles_B: 2
                }
                {
                    name: CS fft D
                    force: false
                    seqLen: 1024,
                    dModel: 64, // x8
                    L1: 32,
                    L2: 32,
                    nb_tiles: 8,
                    nb_tiles_B: 2
                }
            ]
        }
        {
            app: fft-4way
            params: [
                {
                    name: CS fft A
                    force: false
                    seqLen: 65536
                    dModel: 1 // x 96
                    L1: 16,
                    L2: 16,
                    L3: 16,
                    L4: 16,
                    nb_tiles_A: 1
                    l3_tile: 16
                }
            ]
        }
        {
            app: fft-3way-tiled
            params: [
                {
                    name: IN fft A
                    force: false
                    seqLen: 4096,
                    dModel: 24, // x4
                    L1: 16,
                    L2: 16,
                    L3: 16,
                    nb_tiles_A: 4
                    l3_tile: 16

                }
                {
                    name: CS fft A
                    force: false
                    seqLen: 65536
                    dModel: 1 // x 96
                    L1: 64,
                    L2: 16,
                    L3: 64,
                    nb_tiles_A: 1
                    l3_tile: 16
                }
                {
                    name: CS fft B
                    force: false
                    seqLen: 16384,
                    dModel: 8, // x24
                    L1: 32,
                    L2: 16,
                    L3: 32,
                    nb_tiles_A: 8
                    l3_tile: 16
                }
            ]
        }
        {
            app: fft-3way-tiled-async
            params: [
                {
                    name: CS fft A
                    force: false
                    seqLen: 65536
                    dModel: 1 // x 96
                    L1: 64,
                    L2: 16,
                    L3: 64,
                    nb_tiles_A: 1
                    l3_tile: 16
                    nb_ntile: 4
                }

            ]
        }
        {
            app: isgemm-tiled
            params: [
                // ImageNet
                // Sizes D
                {
                    name: IN fft D
                    force: false
                    dim0: 48
                    dim1: 528
                    dim2: 528
                    nb_tiles: 11
                }
            ]
        }
        {
            // Downsample (inter-stage patch-embed): a dense 3x3 stride-2 Conv2d, mapped as im2col GEMM
            //   seqLen = L_out (= L_in / 4, stride 2)   dModel = K = 9 * C_in (3x3 kernel)   dInner = N = C_out
            app: double-gemm-conflict-free
            params: [
                // ImageNet
                { // 96 -> 192
                    name: IN downsample A
                    force: false
                    seqLen: 96 // 4x
                    dModel: 864 // = 9 * 96
                    dInner: 192
                    nb_tiles: 8
                }
                { // 192 -> 384
                    name: IN downsample B
                    force: false
                    seqLen: 48 // 2x
                    dModel: 1728 // = 9 * 192
                    dInner: 384
                    nb_tiles: 16
                }

            ]
        }
        {
            app: conv-downsample
            params: [
                { // 384 -> 512
                    name: IN downsample C
                    force: false
                    seqLen: 16 // 2x
                    dModel: 3456 // = 9 * 384
                    dInner: 528
                    nb_tiles: 18
                },
            ]
        }
        {
            app: rmsnorm-tiled
            params: [
                // ImageNet
                {
                    name: IN rms A
                    force: false
                    seqLen: 3136
                    dModel: 96
                    nb_tiles: 28 // L_tile=112
                }
                {
                    name: IN rms B
                    force: false
                    seqLen: 784
                    dModel: 192
                    nb_tiles: 7 // L_tile=112
                }
                {
                    name: IN rms C
                    force: false
                    seqLen: 192
                    dModel: 384
                    nb_tiles: 4 // L_tile=48
                }
                {
                    name: IN rms D
                    force: false
                    seqLen: 48
                    dModel: 512
                    nb_tiles: 3 // L_tile=16
                }
                // {
                //     name: CS rms A
                //     force: false
                //     seqLen: 32768
                //     dModel: 96
                //     nb_tiles: 128 // L_tile=256
                // }
                // {
                //     name: CS rms B
                //     force: false
                //     seqLen: 8192
                //     dModel: 192
                //     nb_tiles: 64 // L_tile=128
                // }
                // {
                //     name: CS rms C
                //     force: false
                //     seqLen: 2048
                //     dModel: 384
                //     nb_tiles: 16 // L_tile=128
                // }
                // {
                //     name: CS rms D
                //     force: false
                //     seqLen: 512
                //     dModel: 512
                //     nb_tiles: 8 // L_tile=64
                // }
            ]
        }

        {
            app: double-gemm-conflict-free
            params: [
                {
                    name: CS segformer A
                    force: false
                    seqLen: 128 // x256 -> 32768
                    dModel: 96
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 11
                }
                {
                    name: CS segformer B
                    force: false
                    seqLen: 128 // x64 -> 8192
                    dModel: 192
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 11
                }
                {
                    name: CS segformer C
                    force: false
                    seqLen: 64 // x32 -> 2048
                    dModel: 384
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 11
                }
                {
                    name: CS segformer D
                    force: false
                    seqLen: 64 // x8 -> 512
                    dModel: 512
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 11
                }
                {
                    name: CS segformer E
                    force: false
                    seqLen: 32 // x1024 -> 32768
                    dModel: 2048
                    dInner: 528
                    dtRank: 24
                    nb_tiles: 22
                }
            ]
        }
        {
            // SegFormer head BatchNorm+ReLU
            // Channels is always the same (512). SeqLen corresponds to layers A,B,C,D,A -> total = 76288 = 128 * 596
            app: batchnorm
            params: [
                {
                    name: CS batchnorm
                    force: false
                    seqLen: 128 // x596
                    channels: 528
                }
            ]
        }
    ]
}
