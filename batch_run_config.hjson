                //     seqLen: 784
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 4
                // }
                // Sizes C
                {
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 4
                }
                {
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 0
                }
                // Sizes D
                {
                    seqLen: 48
                    dModel: 512
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 0
                }
            ]
        }
        {
            app: einfft-tiled
            params: [
                // Sizes A
                {
                    seqLen: 784 // x4
                    dModel: 96
                }
                // Sizes B
                {
                    seqLen: 392
                    dModel: 192
                    nb_tiles: 2
                }
                // Sizes C
                {
                    seqLen: 192
