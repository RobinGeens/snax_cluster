{
    // Max number of vsim runs allowed to execute at the same time
    max_parallel: 5
    // Per-run wall-clock cap in seconds. 0 = no timeout.
    timeout: 10800

    runs: [
        {
            app: main-tiled
            params: [
                // Sizes B
                // {
                //     seqLen: 784
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 4
                // }
                // Sizes C
                {
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 4
                }
                {
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 0
                }
                // Sizes D
                {
                    seqLen: 48
                    dModel: 512
                    dtRank: 24
                    nb_tiles: 32
                    bc_pad_banks: 0
                }
            ]
        }
        {
            app: main-tiled-oscore
            params: [
                // Sizes B
                // { // OOM
