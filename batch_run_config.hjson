{
    // Max number of vsim runs allowed to execute at the same time
    max_parallel: 8
    // Per-run wall-clock cap in seconds. 0 = no timeout
    timeout: 0
    // Per-build  wall-clock cap in seconds. 0 = no timeout
    build_timeout: 21600
    // Global default for `force`
    force: true

    runs: [
        {
            app: main-tiled
            params: [
                // Sizes B
                // {
                //     seqLen: 784
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 4
                // }
                // Sizes C
                {
                    name: IN main C
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16 // power of 2. 8 too small
                    bc_pad_banks: 4
                    safe_to_start_r10: 11
                    safe_to_start_r11: 3000 // 8350 // Let's try to start sooner
                }
                {
                    name: IN main C
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    bc_pad_banks: 0
                    safe_to_start_r10: 9
                    safe_to_start_r11: 1990
                }
                // Sizes D
                {
                    name: IN main  D
                    seqLen: 48
                    dModel: 528 // 512 does NOT work
                    dtRank: 24
                    nb_tiles: 11
                    bc_pad_banks: 4
                    safe_to_start_r10: 5
                    safe_to_start_r11: 4200
                }
            ]
        }
        {
            app: main-tiled-oscore
            params: [
                // Sizes B
                // { // OOM
                //     seqLen: 800
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 8
                //     nb_l_tiles: 50
                //     nb_slots: 2
                // }
                // Sizes C
                {
                    name: IN main C
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    nb_l_tiles: 12
                    nb_slots: 2
                    bc_pad_banks: 0
                    safe_to_start_r10: 9
                    safe_to_start_r11: 4000
                }
                {
                    name: IN main C
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    nb_l_tiles: 12
                    nb_slots: 4
                    bc_pad_banks: 4
                    safe_to_start_r10: -1
                    safe_to_start_r11: -1
                }
            ]
        }
        {
            app: P1-tiled-D
            params: [
                // Sizes A
                {
                    name: IN P1 A
                    force: false
                    seqLen: 784 // x4
                    dModel: 96
                    dtRank: 24
                    nb_tiles: 4
                }
                // Sizes B
                {
                    name: IN P1 B
                    force: false
                    seqLen: 784
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                }
                // // Sizes C
                // { // Use main instead
                //     seqLen: 192
                //     dModel: 384
                //     dtRank: 24
                //     nb_tiles: 16
                // }
                // // Sizes D
                // { // Use main instead
                //     seqLen: 48
                //     dModel: 504
                //     dtRank: 24
                //     nb_tiles: 21
                // }
            ]
        }
        {
            app: P2-tiled-D
            params: [
                // Sizes B
                // {
                //     seqLen: 784
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 16
                //     bc_pad_banks: 4
                // }
                // Sizes C
                {
                    name: IN P2 C
                    force: false
                    seqLen: 192
                    dModel: 384
                    dtRank: 24
                    nb_tiles: 16
                    bc_pad_banks: 4
                    safe_to_start_r10: 12
                    safe_to_start_r11: 6000
                }
                // Sizes D
                {
                    name: IN P2 D
                    force: false
                    seqLen: 48
                    dModel: 480
                    dtRank: 24
                    nb_tiles: 10
                    bc_pad_banks: 4
                    safe_to_start_r10: 3
                    safe_to_start_r11: 2200
                }
            ]
        }
        {
            app: is-osgemm-tiled
            params: [
                // Cityscapes
                // Sizes B
                { // z proj
                    name: CS P2 in proj B
                    force: false
                    seqLen: 512 // 8x (kernel does 2x this L -> 8k total)
                    dModel: 192
                    dInner: 384
                    dtRank: 24
                    nb_tiles: 8
                }
                { // out proj
                    name: CS P2 out proj B
                    force: false
                    seqLen: 512 // 8x (kernel does 2x this L -> 8k total)
                    dModel: 192
                    dInner: 384
                    dtRank: 24
                    nb_tiles: 8
                }
                // ImageNet
                // Sizes A
                { // z proj
                    name: IN P2 in proj A
                    force: false
                    seqLen: 784 // 2x (kernel does 2x this L -> 3k total)
                    dModel: 96
                    dInner: 192
                    dtRank: 24
                    nb_tiles: 4
                }
                { // out proj
                    name: IN P2 out proj A
                    force: false
                    seqLen: 400 // 4x (kernel does 2x this L -> 3k total)
                    dModel: 192
                    dInner: 96
                    dtRank: 24
                    nb_tiles: 4 // 8 not possible
                }
                // Sizes B
                { // out proj
                    name: IN P2 out proj B
                    force: false
                    seqLen: 384 // 2x (kernel does 2x this L -> 784)
                    dModel: 384
                    dInner: 192
                    dtRank: 24
                    nb_tiles: 8
                }

                {  // FFT
                    name: IN fft D
                    force: false
                    seqLen: 48
                    dModel: 512
                    dInner: 1056
                    nb_tiles: 11
                }
            ]
        }
        {
            // SUC P2, all but out proj
            app: P2-async-OS-no-IS
            params: [
                // Cityscapes
                // Sizes B
                // { // This will certainly OOM...
                //     force: false
                //     seqLen: 8192
                //     dModel: 192
                //     dtRank: 24
                //     nb_tiles: 8
                //     nb_l_tiles: 128
                //     nb_slots: 4
                //     safe_to_start_r10: -1
                //     safe_to_start_r11: 0 // not used
                // }
                // ImageNet
                // Sizes A
                // { // OOM
                //     force: false
                //     seqLen: 3136
                //     dModel: 96
                //     dtRank: 24
                //     nb_tiles: 8
                //     nb_l_tiles: 4
                //     nb_slots: 2
                //     safe_to_start_r10: -1
                //     safe_to_start_r11: -1
                // }
                // Sizes B
                {
                    name: IN SUC/in proj B
                    force: true
                    seqLen: 768
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 4
                    nb_slots: 2
                    safe_to_start_r10: 40
                    safe_to_start_r11: 0 // not used
                }


            ]
        }
        {
            // SUC-only, no z-proj or out-proj
            app: suc-async
            params: [
                // Cityscapes
                // Sizes B
                {
                    name: CS SUC B
                    force: false
                    seqLen: 8192
                    dModel: 192
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 16 // L_tile=512; 128 (L_tile=64) thrashes the ring -> timeout
                    nb_slots: 2
                    bc_pad_banks: 4
                    safe_to_start_r10: 0 // not used
                    safe_to_start_r11: 0 // not used
                }
                // ImageNet
                // Sizes A
                {
                    name: IN SUC A
                    seqLen: 3136
                    dModel: 96
                    dtRank: 24
                    nb_tiles: 8
                    nb_l_tiles: 4
                    nb_slots: 2
                    bc_pad_banks: 4
                    safe_to_start_r10: 0 // not used
                    safe_to_start_r11: 0 // not used
                }

            ]
        }
        {
            app: einfft-tiled
            params: [

                // Imagenet
                // Sizes A
                {
                    name: IN einfft A
                    force: false
                    seqLen: 784 // x4
                    dModel: 96 // N=1 -> concat [W_re|W_im] gives real N=2 (no waste)
                    nb_tiles: 1
                }
                // Sizes B
                {
                    name: IN einfft B
                    force: false
                    seqLen: 384
                    dModel: 192
                    nb_tiles: 2
                }
                // Sizes C
                {
                    name: IN einfft C
                    force: false
                    seqLen: 192
                    dModel: 384
                    nb_tiles: 2
                }
                // Sizes D
                {
                    name: IN einfft D
                    force: false
                    seqLen: 48
                    dModel: 480
                    nb_tiles: 5
                }
            ]
        }
        {
            app: einfft-tiled-is-osgemm
            params: [
                // Sizes A
                // {
                //     seqLen: 3136
                //     dModel: 96
                // }
                // {
                //     seqLen: 784 // x4
                //     dModel: 96 // ! Must be >= 192
                // }
                // Sizes B
                // { // OOM
                //     seqLen: 784
                //     dModel: 192
                // }
                // { // OOM
                //     seqLen: 392 // x2
                //     dModel: 192
                // }
                {
                    name: IN einfft B
                    force: false
                    seqLen: 192 // x4
                    dModel: 192
                }
                // Sizes C
                {
                    name: IN einfft C
                    force: false
                    seqLen: 192
                    dModel: 384
                }
                // Sizes D
                {
                    name: IN einfft D
                    force: false
                    seqLen: 48
                    dModel: 480
                }
            ]
        }
        {
            app: fft-tiled
            params: [

                // Sizes A
                {
                    name: IN fft A
                    seqLen: 4096,
                    dModel: 96
                    L1: 64,
                    L2: 64,
                    nb_tiles: 16,
                    nb_tiles_B: 2
                }
                // Sizes B
                // { // OOM
                //     seqLen: 1024,
                //     dModel: 192,
                //     L1: 32,
                //     L2: 32,
                //     nb_tiles: 4,
                //     nb_tiles_B: 2
                // }
                {
                    name: IN fft B
                    seqLen: 1024,
                    dModel: 96, // x2
                    L1: 32,
                    L2: 32,
                    nb_tiles: 4,
                    nb_tiles_B: 2
                }
                // Sizes C
                {
                    name: IN fft C
                    seqLen: 256,
                    dModel: 384,
                    L1: 16,
                    L2: 16,
                    nb_tiles: 4,
                    nb_tiles_B: 2
                }

            ]
        }
        {
            app: fft-3way-tiled
            params: [
                // Cityscapes
                {
                    name: CS fft A
                    seqLen: 32768
                    dModel: 1, // 96
                    L1: 32,
                    L2: 32,
                    L3: 32,
                    nb_tiles_A: 1
                }
                {
                    name: CS fft B
                    seqLen: 8192,
                    dModel: 48, // x4
                    L1: 32,
                    L2: 16,
                    L3: 16,
                    nb_tiles_A: 8
                }
                {
                    name: IN fft A
                    seqLen: 4096,
                    dModel: 96, // x4
                    L1: 16,
                    L2: 16,
                    L3: 16,
                    nb_tiles_A: 8
                }
            ]
        }
        {
            app: fft-3way-tiled-async
            params: [
                // l3-streamed: fits long sequences (L1=64 needs the per-block L1_padded fix)
                // L2 must stay <= seqLenUnroll (16): L2>16 in the fft-3way stage descriptors is
                // unsupported (gemm2/cmul2 produce garbage). Push the size onto L1 (any mult of 16)
                // and l3-tile L3. So 64k = L1=128, L2=16, L3=32.
                {
                    name: CS fft A 32k
                    seqLen: 32768
                    dModel: 1
                    L1: 64,
                    L2: 16,
                    L3: 32,
                    nb_tiles_A: 1
                    l3_tile: 16
                    nb_ntile: 4
                }
                {
                    name: CS fft A 64k
                    seqLen: 65536
                    dModel: 1
                    L1: 128,
                    L2: 16,
                    L3: 32,
                    nb_tiles_A: 1
                    l3_tile: 16
                    nb_ntile: 8
                }
            ]
            // {
            //     app: batchnorm
            //     params: [
            //         {}
            //     ]
            // }

        }
    ]
}
