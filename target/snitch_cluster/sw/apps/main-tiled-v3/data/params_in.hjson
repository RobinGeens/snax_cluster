{
    // N-tiled iscore_out version of main-tiled.
    // nb_n_tiles: tiles the IS-core output dimension (xProjDim for P1, dModel for P2).
    // Constraints:
    //   - dtRank multiple of dtRankUnroll=6 (scala datagen) — pad above real dtRank=24
    //   - xProjDim = dtRank + 128, divisible by nb_n_tiles, with xProjDim/nb_n_tiles % 4 == 0
    //   - dModel divisible by nb_n_tiles, dModel/nb_n_tiles % 4 == 0
    // L=784 D=192: dtRank=48 → xProjDim=176, nb_n_tiles=4 → xpt=44, dmt=48 → 428 KiB peak.
    "seqLen": 784,
    "dModel": 192,
    "dtRank": 48,
    "nb_tiles": 16,
    "nb_n_tiles": 4
}
